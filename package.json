{
  "name": "pennywyze",
  "version": "1.1.0",
  "description": "Audits which Claude tier is the cheapest one that still passes your quality bar.",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pennywyze": "./dist/cli.js"
  },
  "scripts": {
    "test": "vitest",
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --clean",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syntek-Collective/PennyWyze.git"
  },
  "keywords": [
    "cli",
    "anthropic",
    "claude",
    "llm",
    "cost-optimization",
    "evaluation"
  ],
  "author": "PennyWyze Team",
  "contributors": [
    "Olivia McKelvey",
    "Edward Zgonc",
    "Maia Bard"
  ],
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Syntek-Collective/PennyWyze/issues"
  },
  "homepage": "https://github.com/Syntek-Collective/PennyWyze#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist"
  ]
}
